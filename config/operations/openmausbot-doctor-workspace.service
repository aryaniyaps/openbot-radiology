[Unit]
Description=IT-controlled doctor entry point for native OpenMausBot
After=network.target

[Service]
User=radiology-gateway
ExecStart=/usr/bin/python3 /opt/radiology-client/scripts/operations/doctor-workspace-proxy.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
